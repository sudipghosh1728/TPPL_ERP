MONGODB_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=tppl_erp

# SMTP for automatic project-deletion emails and the dispatch archive worker.
# Keep disabled for isolated local previews. Set these privately on Vercel Production.
ARCHIVE_MAIL_ENABLED=false
SMTP_HOST=
# 587 uses STARTTLS; 465 uses implicit TLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Company-owned file storage. Default preserves current MongoDB storage.
# Use remote on Vercel; disk is only for an ERP hosted on the drive's computer.
FILE_STORAGE_MODE=mongo
FILE_STORAGE_ID=
FILE_STORAGE_ROOT=
FILE_STORAGE_URL=
FILE_STORAGE_TOKEN=
# Optional trusted CA file for an internal HTTPS certificate (never disable TLS).
FILE_STORAGE_CA_FILE=
