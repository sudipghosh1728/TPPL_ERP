{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build_production.py",
  "outputDirectory": "web-dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.tools/**,data/**,test-results/**,test_*.py,browser-*.cjs,.env*,TPPL/**,web-dist/**,public/website/**,local_preview.py,mongo_test_support.py,start-local-preview.ps1}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/erp.html"
    },
    {
      "source": "/user",
      "destination": "/erp.html"
    }
  ],
  "regions": [
    "bom1"
  ]
}
